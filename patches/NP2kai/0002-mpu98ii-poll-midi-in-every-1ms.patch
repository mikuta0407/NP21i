diff --git a/cbus/mpu98ii.c b/cbus/mpu98ii.c
index 77525ac..5c27166 100755
--- a/cbus/mpu98ii.c
+++ b/cbus/mpu98ii.c
@@ -1194,6 +1194,10 @@ void mpu98ii_bind(void) {
 	
 	if(mpu98.enable){
 		mpu98ii_changeclock();
+#if defined(SUPPORT_MPU98_TICK_MIDIIN)
+		nevent_set(NEVENT_MIDIINPOLL, pccore.realclock / 1000,
+										mpu98ii_midiinpoll, NEVENT_ABSOLUTE);
+#endif
 
 		/* Optional stand-alone MPU-98II selected by the emulator setting. */
 		if (np2cfg.mpuenable) {
@@ -1223,6 +1227,19 @@ void mpu98ii_bind(void) {
 	}
 }
 
+#if defined(SUPPORT_MPU98_TICK_MIDIIN)
+// Poll MIDI-IN every 1ms of emulated time instead of once per frame, so that
+// software timing incoming data with its own timer (e.g. Recomposer recording
+// in UART mode) is not quantized to the frame rate.
+void mpu98ii_midiinpoll(NEVENTITEM item) {
+
+	nevent_set(NEVENT_MIDIINPOLL, pccore.realclock / 1000,
+										mpu98ii_midiinpoll, NEVENT_RELATIVE);
+	mpu98ii_callback();
+	(void)item;
+}
+#endif
+
 //#define MIDIIN_DEBUG
 
 void mpu98ii_callback(void) {
